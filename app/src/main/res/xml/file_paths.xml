<?xml version="1.0" encoding="utf-8"?>
<!--
  Exposes ONLY the private cache folder used for Sharesheet hand-offs.

  Decrypted media is copied to cache/share/<id>.<ext> immediately before it is shared,
  handed to the receiving app as a content:// URI with a temporary read grant, and removed
  later by ShareCleanupWorker. No other app data — pending captures, keys, tokens — is
  reachable through the provider.
-->
<paths>
    <cache-path
        name="slimex_share"
        path="share/" />
</paths>
