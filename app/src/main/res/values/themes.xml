<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme: pure black, no action bar, edge-to-edge friendly. -->
    <style name="Theme.SlimeX" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/slimex_black</item>
        <item name="android:colorBackground">@color/slimex_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/slimex_black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowActivityTransitions">true</item>
    </style>

    <!-- System splash screen shown before Compose takes over (androidx.core:core-splashscreen). -->
    <style name="Theme.SlimeX.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/slimex_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/slimex_black</item>
        <item name="postSplashScreenTheme">@style/Theme.SlimeX</item>
    </style>

</resources>
